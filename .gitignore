build/
cmake-build-*/
out/
Debug/
Release/

# CMake generated files
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
Makefile

# Compiler and tooling caches
.cache/
compile_commands.json

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.swp
*.swo
*~

# Logs
*.log